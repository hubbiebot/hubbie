{
  "name": "bot-hubbie",
  "version": "0.1.0",
  "description": "Sistema de Atendimento IA Hubbie",
  "main": "index.js",
  "private": true,
  "engines": {
    "node": ">=24 <25"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "start": "node index.js",
    "api:start": "node apps/api/src/server.js",
    "api:dev": "node --watch apps/api/src/server.js",
    "worker:start": "npm run start -w @hubbie/worker",
    "worker:dev": "npm run dev -w @hubbie/worker",
    "media-worker:start": "npm run start -w @hubbie/media-worker",
    "media-worker:dev": "npm run dev -w @hubbie/media-worker",
    "web:start": "npm run start -w @hubbie/web",
    "web:build": "npm run build -w @hubbie/web",
    "format:check": "prettier --check \"apps/api/**/*.{js,json}\" \"apps/worker/**/*.{js,json}\" \"apps/media-worker/**/*.{js,json}\" \"packages/**/*.js\" \"packages/**/*.json\" \"eslint.config.mjs\" \"package.json\"",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "build": "pkg . --targets node18-win-x64 --output hubbiebot.exe"
  },
  "pkg": {
    "assets": [
      "public/**/*"
    ],
    "scripts": [
      "index.js"
    ]
  },
  "author": "Arthur Costa",
  "license": "ISC",
  "devDependencies": {
    "prettier": "^3.9.6"
  },
  "dependencies": {
    "dotenv": "^16.6.1",
    "express": "^4.22.1",
    "express-session": "^1.19.0",
    "openai": "^4.104.0",
    "puppeteer": "^24.40.0",
    "qrcode-terminal": "^0.12.0",
    "socket.io": "^4.8.3",
    "whatsapp-web.js": "^1.34.6"
  }
}
